{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "spawn_task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/chip-rigor.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run e2e:*)",
      "Bash(npm run build:*)",
      "Bash(npm run format:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx playwright test:*)",
      "Bash(scripts/dev/grok-review.sh:*)"
    ]
  }
}
