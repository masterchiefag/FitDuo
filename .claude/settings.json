{
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run e2e:*)",
      "Bash(npm run build:*)",
      "Bash(npm run format:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx playwright test:*)",
      "Bash(scripts/dev/record-step.sh:*)",
      "Bash(scripts/dev/merge-ready.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/dev/merge-gate-hook.mjs"
          }
        ]
      }
    ]
  }
}
